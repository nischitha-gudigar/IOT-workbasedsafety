          },
          "query": "from(bucket: \"iot_poc\")\n  |> range(start: -10s)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"vitals\")\n  |> filter(fn: (r) => r[\"sensor_name\"] == \"heart_rate\")\n  |> filter(fn: (r) => r[\"poc_type\"] == \"healthcare\")\n  |> filter(fn: (r) => r[\"_field\"] == \"value\")\n  |> last()",
