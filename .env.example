# .env.example
# Copy this to .env and fill in your values.
# These environment variables override defaults in config/mqtt_config.yaml.

# MQTT broker connection
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=iots

# Ingestion service topic subscription override (optional)
# MQTT_INGEST_TOPIC_SUBSCRIPTION=iots/#

# InfluxDB (used by the POC ingestion service — not directly by the simulator)
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=my-token
INFLUXDB_ORG=iot_org
INFLUXDB_BUCKET=iot_poc

# Simulator behaviour
LOG_LEVEL=INFO
DEMO_API_PORT=8000
